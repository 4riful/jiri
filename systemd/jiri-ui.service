[Unit]
Description=JIRI UI
After=multi-user.target

[Service]
Type=simple
User=pi
SupplementaryGroups=video input spi gpio
WorkingDirectory=/home/pi/jiri
Environment=PYTHONPATH=src
Environment=JIRI_DISPLAY_OUTPUT=fb
EnvironmentFile=-/home/pi/jiri/.env
ExecStart=/home/pi/jiri/.venv/bin/python -m jiri.ui.pygame_app
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
